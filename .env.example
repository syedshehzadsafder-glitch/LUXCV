# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Local MongoDB, or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/luxcv

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7

# Set to true when served over HTTPS (production) so the cookie is Secure.
# In production this is forced on unless you set COOKIE_SECURE=false explicitly.
COOKIE_SECURE=false

# Only needed behind a reverse proxy (Nginx, Render, Heroku...): 1 = trust first proxy
TRUST_PROXY=0
