{
  "name": "luxcv",
  "version": "2.0.0",
  "description": "LUXCV Premium Resume Builder \u2014 static frontend with an Express + MongoDB backend (auth, saved resumes, admin dashboard).",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "create-admin": "node server/scripts/createAdmin.js",
    "check": "node --check index.js && node --check server/server.js",
    "test": "node --test tests/unit.test.js",
    "test:e2e": "node tests/e2e/flows.js && node tests/e2e/regression.js && node tests/e2e/nav.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "playwright": "^1.45.0"
  }
}
